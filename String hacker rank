import sys

def solve():
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    A = input_data[0]
    n = len(A)
    if n == 0:
        print(0)
        return
        
    dp = [0] * n
    prev_dp = [0] * n
    
    for i in range(n - 1, -1, -1):
        dp[i] = 1
        for j in range(i + 1, n):
            if A[i] == A[j]:
                dp[j] = prev_dp[j - 1] + 2
            else:
                dp[j] = max(prev_dp[j], dp[j - 1])
        prev_dp = list(dp)
        
    print(dp[n - 1])

if __name__ == "__main__":
    solve()

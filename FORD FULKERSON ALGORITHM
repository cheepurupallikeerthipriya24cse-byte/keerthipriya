from collections import deque

V, E = map(int, input().split())

capacity = [[0] * V for _ in range(V)]

for _ in range(E):
    u, v, c = map(int, input().split())
    capacity[u][v] += c

def bfs(source, sink, parent):
    visited = [False] * V
    queue = deque([source])
    visited[source] = True

    while queue:
        u = queue.popleft()

        for v in range(V):
            if not visited[v] and capacity[u][v] > 0:
                parent[v] = u
                visited[v] = True

                if v == sink:
                    return True

                queue.append(v)

    return False

source = 0
sink = V - 1
max_flow = 0

parent = [-1] * V

while bfs(source, sink, parent):
    path_flow = float('inf')
    v = sink

    while v != source:
        u = parent[v]
        path_flow = min(path_flow, capacity[u][v])
        v = u

    v = sink

    while v != source:
        u = parent[v]
        capacity[u][v] -= path_flow
        capacity[v][u] += path_flow
        v = u

    max_flow += path_flow

print(max_flow)
